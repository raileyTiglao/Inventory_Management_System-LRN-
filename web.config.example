<?xml version="1.0" encoding="UTF-8"?>
<!--
  NOT ACTIVE. Rename this to `web.config` only after confirming the IIS
  URL Rewrite module is installed on the host:
  https://www.iis.net/downloads/microsoft/url-rewrite

  Why it ships inactive: IIS does not ignore configuration sections it
  doesn't recognise. With the module absent, the <rewrite> section below
  makes IIS fail EVERY request under this folder with HTTP 500.19
  ("Unrecognized configuration section system.webServer/rewrite") — the
  whole app goes down, not just the clean URLs this enables.

  The app does not need this file. With CLEAN_URLS = false in config.php
  every generated link is the index.php?page=... form, which needs no
  server module at all. This only adds the prettier /ims/inventory style.

  Enabling it is a two-step change:
    1. rename this file to web.config
    2. set CLEAN_URLS = true in config.php

  The Apache equivalent is .htaccess, which IIS never reads (so it is safe
  to leave in place). Keep the two in sync.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="IMS front controller" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Serve real files (styles, scripts, assets, api/*.php) as-is;
                 everything else is a route for index.php. -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
